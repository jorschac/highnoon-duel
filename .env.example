# 本地默认回环地址；本地服务不会自动加载 .env，请用 shell 导出或 Node --env-file。
HOST=127.0.0.1
PORT=3030
# Vercel 必须设置 Redis TLS URL。不要使用 VITE_ 前缀，不要提交真实值。
# REDIS_URL=rediss://<username>:<password>@<your-redis-host>:6379
# 可选专用命名空间；Preview 默认与 Production 分离。
# REDIS_KEY=highnoon:v1:production
# 可选实际页面 Origin 逗号列表；同请求源在服务端独立验证。
# ALLOWED_ORIGINS=https://your-game.vercel.app
# 临时公网测试可启用服务端口令；真实口令不能提交代码或放公开配置。
# TEST_CODE=your-private-test-code
