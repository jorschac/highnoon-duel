{
  "name": "highnoon-duel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "node --import tsx server/local.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --import tsx server/local.ts --production"
  },
  "dependencies": {
    "express": "^5.1.0", "fengari": "^0.1.4", "ioredis": "^5.6.1",
    "react": "^19.1.0", "react-dom": "^19.1.0", "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1", "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3", "@types/node": "^22.18.0", "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0", "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "^7.1.0"
  }
}
